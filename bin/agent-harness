#!/usr/bin/env python3
"""
agent-harness CLI
Universal AI Agent Anti-Drift Framework & Knowledge Graph Harness
Works with TRAE, Cursor, Claude Code, Antigravity, Windsurf, Zed, and VS Code.
"""

import os
import sys
import json
import subprocess
import re
import webbrowser
import shutil

VERSION = "1.0.5"

if sys.platform == "win32":
    CBM_BIN = os.path.expanduser("~/.local/bin/codebase-memory-mcp.exe")
else:
    CBM_BIN = os.path.expanduser("~/.local/bin/codebase-memory-mcp")

BANNER = r"""
   ___                    __     __ __                                 
  / _ | ___ ____ ___  __ / /_   / // /___ _ ____ ___  ___  ___ ___    
 / __ |/ _ `/ -_) _ \/ // / -_) / _  // _ `// __// _ \/ -_)(_-<(_-<   
/_/ |_|\_, /\__/_//_/\_,_/\__/ /_//_/ \_,_//_/  /_//_/\__//___/___/   
      /___/                                                            
       Universal Anti-Drift & Codebase Memory Harness for AI Agents
"""

def print_help():
    print(BANNER)
    print(f"Version: {VERSION}\n")
    print("Usage:")
    print("  agent-harness init [path]    Index codebase & bootstrap tailor-made AGENTS.md")
    print("  agent-harness check [path]   Verify AGENTS.md matches repo stack, entry points, tests")
    print("  agent-harness sync [path]    Refresh marker-managed facts in AGENTS.md (keeps custom rules)")
    print("  agent-harness setup          Pre-configure MCP for all supported AI IDEs (installed or not)")
    print("  agent-harness status         Show codebase memory daemon & indexed projects status")
    print("  agent-harness ui             Open the 3D Knowledge Graph UI in browser (localhost:9749)")
    print("  agent-harness version        Print version")
    print("  agent-harness --help         Show this help message\n")

def run_cmd(cmd, check=False):
    res = subprocess.run(cmd, capture_output=True, text=True)
    if check and res.returncode != 0:
        raise RuntimeError(res.stderr.strip() or res.stdout.strip())
    return res

def extract_json_payload(output_text):
    """
    Robustly extracts a valid JSON root object from output text that may contain
    arbitrary prefix logs (even logs containing curly brackets like {host})
    and trailing logs or garbage.
    """
    if not output_text:
        return None
    decoder = json.JSONDecoder()
    idx = output_text.find('{')
    while idx != -1:
        try:
            obj, _ = decoder.raw_decode(output_text[idx:])
            return obj
        except json.JSONDecodeError:
            idx = output_text.find('{', idx + 1)
    return None

def run_cbm_cli(tool, params=None):
    if not os.path.exists(CBM_BIN):
        return None
    cmd = [CBM_BIN, "cli", "--json", tool]
    res = subprocess.run(cmd, input=json.dumps(params or {}), capture_output=True, text=True)
    output = res.stdout or ""
    parsed = extract_json_payload(output)
    if isinstance(parsed, dict) and isinstance(parsed.get("structuredContent"), dict):
        return parsed["structuredContent"]
    if parsed is not None:
        return parsed
    if (res.stderr or output) and os.environ.get("DEBUG"):
        err_msg = res.stderr.strip() if res.stderr else output.strip()
        print(f"⚠️ CBM CLI parse or execution failure: {err_msg}", file=sys.stderr)
    return None

def get_templates_dir():
    """Locates templates directory across multiple candidate locations."""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(script_dir, "..", "templates"),
        os.path.join(script_dir, "templates"),
        os.path.expanduser("~/.local/share/agent-harness/templates")
    ]
    for c in candidates:
        if os.path.isdir(c):
            return os.path.abspath(c)
    return None

DEFAULT_KARPATHY_RULES = """## 2. Karpathy 防翻车四大行为准则（The 4 Golden Rules）

### 准则 1：【先想再写 (Think Before Writing)】
- **把假设说出口**：需求存在两种或以上的理解时，**先向开发者列出各种理解并确认，再动手写代码**；
- 开发者的方案有更简单或更健壮的替代实现时，主动提出并说明理由，由开发者决定采用哪一种；
- 对需求理解清晰、能说出验收标准之后，再开始写代码。

### 准则 2：【简单优先 (Keep It Simple & Minimal)】
- **写解决问题所需的最少代码**；
- 只实现本次需求用到的功能（Speculative Features 一律留到真正需要时再写）；只用一次的逻辑直接写在调用处；只处理真实可能出现的输入与场景；
- **判断标准**：写完后用资深工程师的眼光复查，能删的删，能简化的简化。

### 准则 3：【手术式修改 (Surgical Edits)】
- **只动任务要求碰的代码**；
- 与任务无关的代码和文件保持原样（包括格式）；发现值得改进之处，在回复里告诉开发者，由开发者决定是否另开任务；
- 严格遵循项目中已有的编码风格与缩进规范，让 Git Diff 只包含完成任务所需的最小改动，便于逐行审查。

### 准则 4：【目标驱动与自检验收 (Goal-Driven Execution)】
- 将每个开发/修复任务转化为**客观可验证的目标**：
  - “修复 Bug” $\\to$ 先构造一个能稳定复现该 Bug 的最小测试，修改代码，直到测试由红变绿；
  - “添加功能” $\\to$ 必须配套对应的测试用例与调用校验。
- 宣告完成时，附上刚刚在终端实际运行的测试命令及其通过结果。"""

def load_karpathy_rules():
    """Loads Karpathy rules dynamically from template file with embedded fallback."""
    td = get_templates_dir()
    if td:
        tpath = os.path.join(td, "karpathy_rules.md")
        if os.path.isfile(tpath):
            try:
                with open(tpath, "r", encoding="utf-8") as f:
                    content = f.read().strip()
                    if content:
                        return content
            except Exception:
                pass
    return DEFAULT_KARPATHY_RULES

def parse_architecture(target_dir):
    """Languages and entry points from filesystem rules only, so init, check and sync always agree."""
    ext_counts = {}
    ext_map = {
        ".go": "Go", ".rs": "Rust", ".py": "Python", ".ts": "TypeScript",
        ".js": "JavaScript", ".java": "Java", ".c": "C", ".cpp": "C++",
        ".rb": "Ruby", ".php": "PHP", ".swift": "Swift", ".kt": "Kotlin"
    }
    skip_dirs = {"node_modules", "target", "vendor"}
    for root, dirs, files in os.walk(target_dir):
        dirs[:] = [d for d in dirs if d not in skip_dirs and not d.startswith(".")]
        for f in files:
            ext = os.path.splitext(f)[1].lower()
            if ext in ext_map:
                lang = ext_map[ext]
                ext_counts[lang] = ext_counts.get(lang, 0) + 1
    if ext_counts:
        sorted_langs = sorted(ext_counts.items(), key=lambda x: x[1], reverse=True)
        languages_str = ", ".join([l[0] for l in sorted_langs[:5]])
    else:
        languages_str = "自动检测 / 多语言"

    entry_points = []
    common_entries = [
        "main.rs", "src/main.rs", "main.go", "cmd/main.go",
        "src/index.ts", "src/index.js", "app.py", "main.py", "src/main.py"
    ]
    for ce in common_entries:
        if os.path.isfile(os.path.join(target_dir, ce)):
            entry_points.append(ce)
    bin_dir = os.path.join(target_dir, "bin")
    if os.path.isdir(bin_dir):
        for fname in sorted(os.listdir(bin_dir)):
            if fname.startswith(".") or fname.endswith((".cmd", ".bat", ".ps1")):
                continue
            if os.path.isfile(os.path.join(bin_dir, fname)):
                entry_points.append("bin/" + fname)

    return languages_str, entry_points

def has_python_bin_script(project_dir):
    bin_dir = os.path.join(project_dir, "bin")
    if not os.path.isdir(bin_dir):
        return False
    for fname in os.listdir(bin_dir):
        fpath = os.path.join(bin_dir, fname)
        if not os.path.isfile(fpath):
            continue
        if fname.endswith(".py"):
            return True
        with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
            first_line = f.readline()
        if first_line.startswith("#!") and "python" in first_line:
            return True
    return False

def detect_stacks(project_dir):
    """Filesystem signals used by harness synthesis and AGENTS.md alignment checks."""
    has_python = (
        os.path.exists(os.path.join(project_dir, "pyproject.toml")) or
        os.path.exists(os.path.join(project_dir, "requirements.txt")) or
        os.path.exists(os.path.join(project_dir, "setup.py")) or
        os.path.exists(os.path.join(project_dir, "setup.cfg")) or
        os.path.exists(os.path.join(project_dir, "Pipfile")) or
        any(f.endswith(".py") for f in os.listdir(project_dir) if os.path.isfile(os.path.join(project_dir, f))) or
        (os.path.isdir(os.path.join(project_dir, "tests")) and any(f.endswith(".py") for f in os.listdir(os.path.join(project_dir, "tests")))) or
        has_python_bin_script(project_dir)
    )
    return {
        "rust": os.path.exists(os.path.join(project_dir, "Cargo.toml")),
        "go": os.path.exists(os.path.join(project_dir, "go.mod")),
        "node": os.path.exists(os.path.join(project_dir, "package.json")),
        "python": has_python,
    }

def detect_test_harness(project_dir):
    """
    Detects test commands and build tools based on files in project_dir.
    Supports multi-stack monorepos (e.g. Go backend + TS frontend, or Rust core + Python bindings).
    """
    harness = []
    stacks = detect_stacks(project_dir)

    if stacks["rust"]:
        harness.append("- **Rust 编译与测试**：`cargo check && cargo test`")
        harness.append("- **Rust 代码质量 (Clippy)**：`cargo clippy --all-targets -- -D warnings`")

    if stacks["go"]:
        harness.append("- **Go 编译与单元测试**：`go build ./... && go test -v ./...`")
        harness.append("- **Go 静态代码检查 (Vet)**：`go vet ./...`")

    if stacks["node"]:
        harness.append("- **Node/TS 类型与测试**：`npx tsc --noEmit && npm test` (或 `pnpm test` / `bun test`)")
        harness.append("- **Node/TS 代码风格 (Lint)**：`npm run lint`")

    if stacks["python"]:
        has_pytest = (
            os.path.exists(os.path.join(project_dir, "pytest.ini")) or
            os.path.exists(os.path.join(project_dir, "conftest.py"))
        )
        if has_pytest:
            harness.append("- **Python 单元测试**：`pytest`")
        else:
            harness.append("- **Python 单元测试**：`python3 -m unittest discover -s tests -v` (若安装了 pytest 也可直接执行 `pytest`)")
        harness.append("- **Python 语法与质量**：`python3 -m py_compile <入口文件>` 或 `ruff check .`")

    if not harness:
        harness.append("- **测试验证**：`# 请在此填入该技术栈的单元测试命令（如 pytest / go test / npm test）`")
        harness.append("- **构建检查**：`# 请在此填入该技术栈的构建/语法检查命令`")

    harness.append("- **文档与代码对齐检查**：`agent-harness check`")
    return "\n".join(harness)

AUTO_MARK = "agent-harness:auto:{name}"

DOC_ALIGNMENT_SECTION = """### 文档与代码对齐（防下一会话漂移）
- 下一会话会把 `AGENTS.md` 与 README / `docs/` 当作事实源：改代码时同步改文档，事实源才可信。
- **必须同步文档**：对外行为、CLI/API、入口点、技术栈、测试命令、架构分层。
- **纯内部实现的改动**（上述事实均未变化）：文档保持原样。
- 交付前运行 `agent-harness check`。带 `<!-- agent-harness:auto:* -->` 标记的字段可用 `agent-harness sync` 刷新。**sync 只刷新带标记的字段，第 5 节业务红线始终由开发者维护。**
- **只写正确做法**：写规则、文档、注释或会话总结时，每条约束都写成「做什么、怎么做」的肯定句，只写正确做法本身。
- **长期要求写进本文件**：开发者在对话中提出、以后所有会话都要遵守的要求，当轮用肯定句写进本文件第 5 节，并在回复中说明新增了哪一条。
"""

def format_entry_points_md(entry_points):
    if entry_points:
        return "\n".join(["- `{0}`".format(ep) for ep in entry_points[:10]])
    return "- 暂无显式 main 入口（待开发定义）"

def wrap_auto(name, inner):
    start = "<!-- " + AUTO_MARK.format(name=name) + " -->"
    end = "<!-- /" + AUTO_MARK.format(name=name) + " -->"
    return start + inner + end

def replace_auto_block(content, name, inner):
    start = "<!-- " + AUTO_MARK.format(name=name) + " -->"
    end = "<!-- /" + AUTO_MARK.format(name=name) + " -->"
    pattern = re.compile(re.escape(start) + r".*?" + re.escape(end), re.DOTALL)
    replacement = start + inner + end
    new_content, n = pattern.subn(replacement, content, count=1)
    return new_content, n > 0

def alignment_issues(target_dir):
    """Return human-readable mismatches between repo facts and AGENTS.md. Empty means aligned."""
    issues = []
    agents_path = os.path.join(target_dir, "AGENTS.md")
    if not os.path.isfile(agents_path):
        return ["缺少 AGENTS.md，请先运行 `agent-harness init`"]

    with open(agents_path, "r", encoding="utf-8", errors="ignore") as f:
        text = f.read()
    text_l = text.lower()

    languages_str, entry_points = parse_architecture(target_dir)
    skip_langs = {"自动检测 / 多语言", "自动检测", "多语言"}
    for lang in [part.strip() for part in languages_str.split(",") if part.strip()]:
        if lang in skip_langs:
            continue
        if not re.search(r"(?<![A-Za-z])" + re.escape(lang) + r"(?![A-Za-z])", text):
            issues.append("仓库含 {0} 代码，但 AGENTS.md 未记录该语言".format(lang))

    for ep in entry_points:
        if ep not in text:
            issues.append("入口点 `{0}` 存在于仓库，但 AGENTS.md 未列出".format(ep))

    stacks = detect_stacks(target_dir)
    stack_needles = [
        ("rust", ["cargo"], "Cargo.toml"),
        ("go", ["go test"], "go.mod"),
        ("node", ["npm test", "pnpm test", "yarn test", "bun test"], "package.json"),
        ("python", ["unittest", "pytest"], "Python 工程"),
    ]
    for key, needles, label in stack_needles:
        if stacks.get(key) and not any(needle.lower() in text_l for needle in needles):
            issues.append("检测到 {0}，但 AGENTS.md 未包含对应测试命令（{1}）".format(label, " / ".join(needles)))

    return issues

def working_tree_undocumented_warning(target_dir):
    git_meta = os.path.join(target_dir, ".git")
    if not os.path.exists(git_meta):
        return None
    res = subprocess.run(
        ["git", "diff", "--name-only", "HEAD"],
        cwd=target_dir,
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        return None
    files = [line.strip() for line in res.stdout.splitlines() if line.strip()]
    code_exts = {
        ".py", ".go", ".rs", ".ts", ".tsx", ".js", ".jsx", ".java",
        ".c", ".cpp", ".h", ".rb", ".php", ".swift", ".kt",
    }
    code_changed = False
    docs_changed = False
    for rel in files:
        ext = os.path.splitext(rel)[1].lower()
        if ext == ".md":
            docs_changed = True
        elif ext in code_exts or rel.startswith("bin/"):
            code_changed = True
    if code_changed and not docs_changed:
        return (
            "工作区有代码改动但没有任何 Markdown 文档改动。"
            "若涉及对外行为 / 入口点 / 测试命令 / 公共 API，请同步更新 AGENTS.md 与 README/docs。"
        )
    return None

def cmd_init(target_dir):
    target_dir = os.path.abspath(target_dir)
    if not os.path.isdir(target_dir):
        print(f"❌ Error: {target_dir} is not a valid directory.")
        sys.exit(1)

    agents_path = os.path.join(target_dir, "AGENTS.md")
    project_name = os.path.basename(target_dir)

    print(f"\n🚀 [agent-harness] Initializing project: {project_name}")
    print(f"📁 Target path: {target_dir}")

    # Step 1: Index repository
    print("⏳ Building / updating codebase knowledge graph via codebase-memory-mcp...")
    idx_res = run_cbm_cli("index_repository", {"repo_path": target_dir})
    if isinstance(idx_res, dict) and "nodes" in idx_res:
        print(f"✅ Graph indexed: {idx_res['nodes']} nodes, {idx_res.get('edges', 0)} edges.")
    elif not os.path.exists(CBM_BIN):
        print("ℹ️ Graph indexing skipped (codebase-memory-mcp not installed).")
    else:
        print("⚠️ codebase-memory-mcp returned a result agent-harness does not understand — the engine's output "
              "format may have changed. AGENTS.md is unaffected; update agent-harness or run with DEBUG=1 for details.")

    # Check if AGENTS.md already exists
    if os.path.exists(agents_path):
        print(f"🛡️  AGENTS.md already exists at: {agents_path}")
        print("⏭️  Skipping creation to protect existing rules from being overwritten.")
        print("💡 若技术栈或测试命令已变，运行 `agent-harness sync` 刷新带标记的事实字段；交付前运行 `agent-harness check`。")
    else:
        # Step 2: Detect stack facts
        print("🔍 Detecting languages, entry points & test commands...")
        languages_str, entry_points = parse_architecture(target_dir)
        harness_md = detect_test_harness(target_dir)
        karpathy_rules_md = load_karpathy_rules()
        entry_points_md = format_entry_points_md(entry_points)

        print("📝 Synthesizing tailor-made AGENTS.md (Karpathy Rules + Test Harness)...")
        content = f"""# {project_name} AI 智能体开发规范与项目指令 (AGENTS.md)

欢迎来到 **{project_name}** 项目！本项目由独立全栈开发者维护。AI 智能体在进行开发与修改时，必须将本文件视为**最高工程铁律**。

> **【AI 开发纪律 · 动手前必读】**
> 在编写或修改任何代码之前，必须通读本规范。模型每次会话都从零开始，本文件是跨会话唯一可靠的记忆与代码质量围栏。**需求以开发者确认的为准；每次交付都附带实际运行通过的测试。**

---

## 1. 核心技术栈与架构基线
- **项目名称**：`{project_name}`
- **主要技术栈 / 语言**：{wrap_auto("languages", languages_str)}
- **核心入口点 (Entry Points)**：
{wrap_auto("entries", chr(10) + entry_points_md + chr(10))}

---

{karpathy_rules_md}

---

## 3. 测试框架（Test Harness）与执行闭环

> **物理围栏机制**：智能体改动代码后，必须调用终端命令自我闭环：
> `编写/修改代码` $\\to$ `运行检查命令` $\\to$ `根据报错自愈修复` $\\to$ `重新运行测试` $\\to$ `全部绿灯后交付`。

### 本项目测试与校验命令：
{wrap_auto("harness", chr(10) + harness_md + chr(10))}

{DOC_ALIGNMENT_SECTION}
**闭环铁律**：
1. 测试或编译报错时，读取具体报错栈并自行修复；全部通过后才宣告任务完成；
2. 同一个问题连续修复 3 次仍未解决（如底层依赖或设计阻塞）时，**停下来向开发者汇报具体卡点和已尝试的方案**，等待决策。
3. 若改动改变了对外行为、入口点、技术栈或测试命令，必须同步更新 AGENTS.md（及 README / docs 对应描述），并运行 `agent-harness check` 直至通过。

---

## 4. 代码知识图谱检索纪律 (Codebase Memory)
- 探索系统架构、函数定义、依赖链路或接口路由时，**若当前会话可用 `codebase-memory-mcp` 工具，优先使用它**，先精准定位，再只读取所需的代码：
    - `get_architecture`: 快速获取系统整体拓扑、热点与分层；
    - `search_graph`: 精准查找函数、类、结构体、接口定义；
    - `trace_path`: 追踪上下游完整调用链，评估修改带来的“爆炸半径”；
    - `get_code_snippet`: 精确读取目标源码，让上下文只装必要内容。
- **若工具不可用**（未安装或未配置 MCP），直接改用常规的文件搜索与读取，照常推进任务。

---

## 5. 业务专属红线与约束（待补充）
- *[开发者自定义区域]*：可在此处记录当前项目的特定业务逻辑、私密环境配置、核心数据模型，以及开发者在对话中提出的长期要求。
"""
        with open(agents_path, "w", encoding="utf-8") as f:
            f.write(content)
        print(f"✨ Successfully created: {agents_path}")

    # Step 3: Alias files import AGENTS.md rather than symlink it, so tools that read several rule files (e.g. Cursor) load the rules once.
    print("🔗 Ensuring cross-IDE alias files...")
    for alias in ["CLAUDE.md", "GEMINI.md"]:
        alias_path = os.path.join(target_dir, alias)
        legacy_link = os.path.islink(alias_path) and os.readlink(alias_path) == "AGENTS.md"
        if legacy_link:
            os.remove(alias_path)
        if not os.path.lexists(alias_path):
            with open(alias_path, "w", encoding="utf-8") as f:
                f.write("@AGENTS.md\n")
            print(f"  + {'Replaced symlink' if legacy_link else 'Created'}: {alias} (@AGENTS.md import)")
    cursorrules_path = os.path.join(target_dir, ".cursorrules")
    if os.path.islink(cursorrules_path) and os.readlink(cursorrules_path) == "AGENTS.md":
        os.remove(cursorrules_path)
        print("  - Removed legacy .cursorrules symlink (Cursor reads AGENTS.md natively)")

    # Step 4: Ensure gitignore safety
    git_ignore_path = os.path.join(target_dir, ".gitignore")
    if os.path.exists(git_ignore_path):
        with open(git_ignore_path, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read()
        if ".codebase-memory" not in content:
            with open(git_ignore_path, "a", encoding="utf-8") as f:
                f.write("\n# codebase-memory-mcp\n.codebase-memory/\n*.graph.db*\n*.db.zst\n")
            print("🛡️  Added .codebase-memory/ to project .gitignore")

    print(f"\n🎉 [agent-harness] Ready! You can now start chatting with AI in any tool (TRAE, Cursor, Claude Code, Antigravity).\n")

def cmd_check(target_dir):
    target_dir = os.path.abspath(target_dir)
    if not os.path.isdir(target_dir):
        print(f"❌ Error: {target_dir} is not a valid directory.")
        sys.exit(1)

    warn = working_tree_undocumented_warning(target_dir)
    if warn:
        print("⚠️  {0}\n".format(warn))

    issues = alignment_issues(target_dir)
    if issues:
        print("❌ AGENTS.md 与仓库事实不对齐（会导致下一会话幻觉）：\n")
        for item in issues:
            print("  - {0}".format(item))
        print("\n修复：更新 AGENTS.md，或给托管字段加上 `<!-- agent-harness:auto:* -->` 后运行 `agent-harness sync`。")
        sys.exit(1)

    print("✅ AGENTS.md 与仓库技术栈 / 入口点 / 测试命令对齐。")

def cmd_sync(target_dir):
    target_dir = os.path.abspath(target_dir)
    if not os.path.isdir(target_dir):
        print(f"❌ Error: {target_dir} is not a valid directory.")
        sys.exit(1)

    agents_path = os.path.join(target_dir, "AGENTS.md")
    if not os.path.isfile(agents_path):
        print("❌ 缺少 AGENTS.md，请先运行 `agent-harness init`。")
        sys.exit(1)

    languages_str, entry_points = parse_architecture(target_dir)
    harness_md = detect_test_harness(target_dir)
    entry_points_md = format_entry_points_md(entry_points)

    with open(agents_path, "r", encoding="utf-8") as f:
        content = f.read()
    original = content

    updates = []
    skipped = []
    content, ok = replace_auto_block(content, "languages", languages_str)
    (updates if ok else skipped).append("languages")
    content, ok = replace_auto_block(content, "entries", "\n" + entry_points_md + "\n")
    (updates if ok else skipped).append("entries")
    content, ok = replace_auto_block(content, "harness", "\n" + harness_md + "\n")
    (updates if ok else skipped).append("harness")

    if not updates:
        print("❌ AGENTS.md 中没有 `agent-harness:auto:*` 标记，拒绝改写手写文档。")
        print("   新项目请用当前版本 `agent-harness init`；已有文档可把要托管的段落包进标记后再 sync。")
        sys.exit(1)

    if content != original:
        with open(agents_path, "w", encoding="utf-8") as f:
            f.write(content)
        print("✨ 已刷新 AGENTS.md 自动托管字段：{0}。第 5 节业务红线未改。".format(", ".join(updates)))
    else:
        print("✅ 自动托管字段已是最新：{0}。".format(", ".join(updates)))

    if skipped:
        print("⏭️  无标记字段已跳过（手写保护）：{0}".format(", ".join(skipped)))

    issues = alignment_issues(target_dir)
    if issues:
        print("⚠️  刷新后仍有缺口，请手工补全：")
        for item in issues:
            print("  - {0}".format(item))
        sys.exit(1)

def safe_inject_mcp(target_path, ide_name):
    """Safely injects codebase-memory-mcp into an IDE's JSON configuration with corruption backup."""
    os.makedirs(os.path.dirname(target_path), exist_ok=True)
    data = {}
    if os.path.exists(target_path) and os.path.getsize(target_path) > 0:
        try:
            with open(target_path, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception as e:
            bak_path = target_path + ".bak"
            print(f"  ⚠️ Warning: Failed to parse existing JSON at {target_path} ({e})")
            print(f"     Creating backup at {bak_path} before updating.")
            try:
                shutil.copyfile(target_path, bak_path)
            except Exception:
                pass
            data = {}

    if not isinstance(data, dict):
        data = {}

    data.setdefault("mcpServers", {})["codebase-memory-mcp"] = {
        "command": CBM_BIN,
        "args": []
    }
    with open(target_path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    print(f"  ✅ Configured {ide_name} MCP: {target_path}")

def cmd_setup():
    print(BANNER)
    print("🔧 [agent-harness] Writing MCP config for every supported AI coding tool (tools installed later pick it up automatically)...\n")
    
    # 1. TRAE
    appdata = os.environ.get("APPDATA", "")
    trae_paths = [os.path.expanduser("~/.trae/mcp.json")]
    if sys.platform == "darwin":
        trae_paths.append(os.path.expanduser("~/Library/Application Support/TRAE SOLO CN/User/mcp.json"))
        trae_paths.append(os.path.expanduser("~/Library/Application Support/Trae/User/mcp.json"))
    elif sys.platform == "win32" and appdata:
        trae_paths.append(os.path.join(appdata, "Trae", "User", "mcp.json"))
        trae_paths.append(os.path.join(appdata, "TRAE SOLO CN", "User", "mcp.json"))
        
    for tp in trae_paths:
        safe_inject_mcp(tp, "TRAE")

    # 2. Cursor
    cursor_mcp = os.path.expanduser("~/.cursor/mcp.json")
    safe_inject_mcp(cursor_mcp, "Cursor")

    # 3. Claude Code
    claude_json = os.path.expanduser("~/.claude.json")
    safe_inject_mcp(claude_json, "Claude Code")

    # 4. Antigravity / Gemini CLI
    gemini_mcp = os.path.expanduser("~/.gemini/config/mcp_config.json")
    safe_inject_mcp(gemini_mcp, "Antigravity")

    # 5. Windsurf
    windsurf_paths = [os.path.expanduser("~/.codeium/windsurf/mcp_config.json")]
    if sys.platform == "win32" and appdata:
        userprofile = os.environ.get("USERPROFILE", "")
        if userprofile:
            windsurf_paths.append(os.path.join(userprofile, ".codeium", "windsurf", "mcp_config.json"))
    for wp in windsurf_paths:
        safe_inject_mcp(wp, "Windsurf")

    # 6. Global Git protection
    global_gitignore = os.path.expanduser("~/.gitignore_global")
    if not os.path.exists(global_gitignore):
        with open(global_gitignore, "w", encoding="utf-8") as f:
            f.write("# codebase-memory-mcp\n.codebase-memory/\n*.graph.db*\n*.db.zst\n")
    run_cmd(["git", "config", "--global", "core.excludesfile", global_gitignore])
    print(f"  🛡️  Configured Global Git Exclude: {global_gitignore}")

    print("\n✨ All supported AI development tools are configured and ready!\n")

def cmd_status():
    print(BANNER)
    print("📊 [agent-harness] Checking daemon & knowledge graph status...\n")
    if not os.path.exists(CBM_BIN):
        print(f"❌ Error: {CBM_BIN} not found. Please install codebase-memory-mcp first.")
        return

    # Check daemon via run_cbm_cli
    data = run_cbm_cli("list_projects", {"format": "json"})
    if isinstance(data, dict) and isinstance(data.get("projects"), list):
        projects = data["projects"]
        print("🟢 Knowledge Graph Engine: Running")
        print(f"📁 Indexed Projects: {len(projects)}")
        for p in projects:
            name = p.get("name", "")
            root = p.get("root_path", "")
            print(f"   • {name} -> {root}")
        print("\n🌐 3D Visualizer available at: http://localhost:9749\n")
        return
    print("⚠️ Could not fetch projects list from daemon.")

def cmd_ui():
    url = "http://localhost:9749"
    print(f"🌐 Opening {url} in your default browser...")
    webbrowser.open(url)

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        print_help()
        sys.exit(0)

    subcmd = sys.argv[1].lower()

    if subcmd == "init":
        target = sys.argv[2] if len(sys.argv) > 2 else "."
        cmd_init(target)
    elif subcmd == "check":
        target = sys.argv[2] if len(sys.argv) > 2 else "."
        cmd_check(target)
    elif subcmd == "sync":
        target = sys.argv[2] if len(sys.argv) > 2 else "."
        cmd_sync(target)
    elif subcmd == "setup":
        cmd_setup()
    elif subcmd == "status":
        cmd_status()
    elif subcmd == "ui":
        cmd_ui()
    elif subcmd in ["-v", "--version", "version"]:
        print(f"agent-harness version {VERSION}")
    else:
        print(f"Unknown command: {subcmd}")
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
