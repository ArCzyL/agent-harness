def print_help():
    print(BANNER)
    print(f"Version: {VERSION}\n")
    print("Usage:")
    print("  agent-harness init [path]    Index codebase, bootstrap AGENTS.md, and add IDE stop hooks")
    print("  agent-harness check [path]   Verify stack, entries, test commands, and docs citing changed code")
    print("  agent-harness sync [path]    Refresh marker-managed facts in AGENTS.md (keeps custom rules)")
    print("  agent-harness verify [path]  Run the test commands listed in AGENTS.md (stop hooks add --hook)")
    print("  agent-harness setup          Pre-configure MCP for all supported AI IDEs (installed or not)")
    print("  agent-harness status         Show codebase memory daemon & indexed projects status")
    print("  agent-harness ui             Open the 3D Knowledge Graph UI in browser (localhost:9749)")
    print("  agent-harness version        Print version")
    print("  agent-harness --help         Show this help message\n")

def run_cmd(cmd, check=False):
    res = subprocess.run(cmd, capture_output=True, encoding="utf-8", errors="replace")
    if check and res.returncode != 0:
        raise RuntimeError(res.stderr.strip() or res.stdout.strip())
    return res

def extract_json_payload(output_text):
    """
    Robustly extracts a valid JSON root object from output text that may contain
    arbitrary prefix logs (even logs containing curly brackets like {host})
    and trailing logs or garbage.
    """
    if not output_text:
        return None
    decoder = json.JSONDecoder()
    idx = output_text.find('{')
    while idx != -1:
        try:
            obj, _ = decoder.raw_decode(output_text[idx:])
            return obj
        except json.JSONDecodeError:
            idx = output_text.find('{', idx + 1)
    return None

def run_cbm_cli(tool, params=None):
    if not os.path.exists(CBM_BIN):
        return None
    cmd = [CBM_BIN, "cli", "--json", tool]
    try:
        res = subprocess.run(cmd, input=json.dumps(params or {}), capture_output=True,
                             encoding="utf-8", errors="replace", timeout=CBM_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        if os.environ.get("DEBUG"):
            print(f"⚠️ CBM CLI could not run: {e}", file=sys.stderr)
        return None
    output = res.stdout or ""
    parsed = extract_json_payload(output)
    if isinstance(parsed, dict) and isinstance(parsed.get("structuredContent"), dict):
        return parsed["structuredContent"]
    if parsed is not None:
        return parsed
    if (res.stderr or output) and os.environ.get("DEBUG"):
        err_msg = res.stderr.strip() if res.stderr else output.strip()
        print(f"⚠️ CBM CLI parse or execution failure: {err_msg}", file=sys.stderr)
    return None

def get_templates_dir():
    """Locates templates directory across multiple candidate locations."""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(script_dir, "..", "templates"),
        os.path.join(script_dir, "templates"),
        os.path.expanduser("~/.local/share/agent-harness/templates")
    ]
    for c in candidates:
        if os.path.isdir(c):
            return os.path.abspath(c)
    return None

DEFAULT_KARPATHY_RULES = """## 2. Karpathy 防翻车四大行为准则（The 4 Golden Rules）

### 准则 1：【先想再写 (Think Before Writing)】
- **把假设说出口**：需求存在两种或以上的理解时，**先向开发者列出各种理解并确认，再动手写代码**；
- 开发者的方案有更简单或更健壮的替代实现时，主动提出并说明理由，由开发者决定采用哪一种；
- 对需求理解清晰、能说出验收标准之后，再开始写代码。

### 准则 2：【简单优先 (Keep It Simple & Minimal)】
- **写解决问题所需的最少代码**；
- 只实现本次需求用到的功能（Speculative Features 一律留到真正需要时再写）；只用一次的逻辑直接写在调用处；只处理真实可能出现的输入与场景；
- **判断标准**：写完后用资深工程师的眼光复查，能删的删，能简化的简化。

### 准则 3：【手术式修改 (Surgical Edits)】
- **只动任务要求碰的代码**；
- 与任务无关的代码和文件保持原样（包括格式）；发现值得改进之处，在回复里告诉开发者，由开发者决定是否另开任务；
- 严格遵循项目中已有的编码风格与缩进规范，让 Git Diff 只包含完成任务所需的最小改动，便于逐行审查。

### 准则 4：【目标驱动与自检验收 (Goal-Driven Execution)】
- 将每个开发/修复任务转化为**客观可验证的目标**：
  - “修复 Bug” $\\to$ 先构造一个能稳定复现该 Bug 的最小测试，修改代码，直到测试由红变绿；
  - “添加功能” $\\to$ 必须配套对应的测试用例与调用校验。
- 宣告完成时，附上刚刚在终端实际运行的测试命令及其通过结果。"""

def load_karpathy_rules():
    """Loads Karpathy rules dynamically from template file with embedded fallback."""
    td = get_templates_dir()
    if td:
        tpath = os.path.join(td, "karpathy_rules.md")
        if os.path.isfile(tpath):
            try:
                with open(tpath, "r", encoding="utf-8") as f:
                    content = f.read().strip()
                    if content:
                        return content
            except Exception:
                pass
    return DEFAULT_KARPATHY_RULES

def parse_architecture(target_dir):
    """Languages and entry points from filesystem rules only, so init, check and sync always agree."""
    ext_counts = {}
    ext_map = {
        ".go": "Go", ".rs": "Rust", ".py": "Python",
        ".ts": "TypeScript", ".tsx": "TypeScript",
        ".js": "JavaScript", ".jsx": "JavaScript", ".mjs": "JavaScript", ".cjs": "JavaScript",
        ".vue": "Vue", ".java": "Java", ".c": "C", ".cpp": "C++",
        ".rb": "Ruby", ".php": "PHP", ".swift": "Swift", ".kt": "Kotlin"
    }
    for root, dirs, files in os.walk(target_dir):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith(".")]
        for f in files:
            ext = os.path.splitext(f)[1].lower()
            if ext in ext_map:
                lang = ext_map[ext]
                ext_counts[lang] = ext_counts.get(lang, 0) + 1
    if ext_counts:
        sorted_langs = sorted(ext_counts.items(), key=lambda x: x[1], reverse=True)
        languages_str = ", ".join([l[0] for l in sorted_langs[:5]])
    else:
        languages_str = "自动检测 / 多语言"

    entry_points = []
    common_entries = [
        "main.rs", "src/main.rs", "main.go", "cmd/main.go",
        "src/index.ts", "src/index.js", "app.py", "main.py", "src/main.py"
    ]
    for ce in common_entries:
        if os.path.isfile(os.path.join(target_dir, ce)):
            entry_points.append(ce)
    bin_dir = os.path.join(target_dir, "bin")
    if os.path.isdir(bin_dir):
        for fname in sorted(os.listdir(bin_dir)):
            if fname.startswith(".") or fname.endswith((".cmd", ".bat", ".ps1")):
                continue
            if os.path.isfile(os.path.join(bin_dir, fname)):
                entry_points.append("bin/" + fname)

    return languages_str, entry_points

def python_entry_files(project_dir):
    """Root Python entry files and bin/ scripts (*.py or a python shebang), relative to project_dir."""
    found = [name for name in ("app.py", "main.py", "src/main.py") if os.path.isfile(os.path.join(project_dir, name))]
    bin_dir = os.path.join(project_dir, "bin")
    if not os.path.isdir(bin_dir):
        return found
    for fname in sorted(os.listdir(bin_dir)):
        fpath = os.path.join(bin_dir, fname)
        if not os.path.isfile(fpath):
            continue
        if fname.endswith(".py"):
            found.append("bin/" + fname)
            continue
        with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
            first_line = f.readline()
        if first_line.startswith("#!") and "python" in first_line:
            found.append("bin/" + fname)
    return found

def detect_stacks(project_dir):
    """Filesystem signals used by harness synthesis and AGENTS.md alignment checks."""
    has_python = (
        os.path.exists(os.path.join(project_dir, "pyproject.toml")) or
        os.path.exists(os.path.join(project_dir, "requirements.txt")) or
        os.path.exists(os.path.join(project_dir, "setup.py")) or
        os.path.exists(os.path.join(project_dir, "setup.cfg")) or
        os.path.exists(os.path.join(project_dir, "Pipfile")) or
        any(f.endswith(".py") for f in os.listdir(project_dir) if os.path.isfile(os.path.join(project_dir, f))) or
        (os.path.isdir(os.path.join(project_dir, "tests")) and any(f.endswith(".py") for f in os.listdir(os.path.join(project_dir, "tests")))) or
        any(path.startswith("bin/") for path in python_entry_files(project_dir))
    )
    return {
        "rust": os.path.exists(os.path.join(project_dir, "Cargo.toml")),
        "go": os.path.exists(os.path.join(project_dir, "go.mod")),
        "node": os.path.exists(os.path.join(project_dir, "package.json")),
        "python": has_python,
    }

def _read_text(path, errors="strict"):
    try:
        with open(path, "r", encoding="utf-8", errors=errors) as f:
            return f.read()
    except OSError:
        return ""

def _package_scripts(project_dir):
    try:
        with open(os.path.join(project_dir, "package.json"), "r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    scripts = data.get("scripts")
    if not isinstance(scripts, dict):
        return {}
    return scripts

def _node_package_manager(project_dir):
    if os.path.isfile(os.path.join(project_dir, "pnpm-lock.yaml")):
        return "pnpm"
    if os.path.isfile(os.path.join(project_dir, "yarn.lock")):
        return "yarn"
    if os.path.isfile(os.path.join(project_dir, "bun.lock")) or os.path.isfile(os.path.join(project_dir, "bun.lockb")):
        return "bun"
    return "npm"

STACK_MANIFESTS = {
    "rust": ("Cargo.toml",),
    "go": ("go.mod",),
    "node": ("package.json",),
    "python": ("pyproject.toml", "requirements.txt", "setup.py", "setup.cfg", "Pipfile"),
}
SUBPROJECT_SKIP_DIRS = SKIP_DIRS | {"tests", "test", "__tests__", "testdata", "fixtures", "examples", "example", "samples"}
TEST_COMMANDS = {
    "rust": ["cargo test", "cargo nextest"],
    "go": ["go test"],
    "node": ["npm test", "pnpm test", "yarn test", "bun run test", "npm run test", "pnpm run test", "yarn run test",
             "bun test", "vitest", "jest", "mocha", "playwright test", "scripts.test"],
    "python": ["pytest", "unittest", "tox", "nox"],
}

def _child_dirs(path):
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    return [name for name in names if not name.startswith(".") and name not in SUBPROJECT_SKIP_DIRS
            and os.path.isdir(os.path.join(path, name))]

def _has_manifest(path, stack):
    return any(os.path.isfile(os.path.join(path, name)) for name in STACK_MANIFESTS[stack])

def stack_locations(project_dir):
    """(stack, dir relative to project_dir) pairs; "" is the root. A stack the root lacks is looked up two levels down."""
    root = detect_stacks(project_dir)
    tree = [(child, _child_dirs(os.path.join(project_dir, child))) for child in _child_dirs(project_dir)]
    found = []
    for stack in ("rust", "go", "node", "python"):
        if root[stack]:
            found.append((stack, ""))
            continue
        for child, grandchildren in tree:
            if _has_manifest(os.path.join(project_dir, child), stack):
                found.append((stack, child))
                continue
            for name in grandchildren:
                if _has_manifest(os.path.join(project_dir, child, name), stack):
                    found.append((stack, child + "/" + name))
    return found

def harness_plan(project_dir):
    """Markdown lines for AGENTS.md, plus (label, accepted test commands) per detected stack for check."""
    lines = []
    requirements = []
    for stack, rel in stack_locations(project_dir):
        base = os.path.join(project_dir, rel)
        cd = "cd {0} && ".format(rel) if rel else ""
        where = "（{0}）".format(rel) if rel else ""
        label = "Python 工程" if stack == "python" else STACK_MANIFESTS[stack][0]
        requirements.append((label + where, TEST_COMMANDS[stack]))

        if stack == "rust":
            lines.append("- **Rust 编译与测试{0}**：`{1}cargo check && cargo test`".format(where, cd))
            lines.append("- **Rust 代码质量 (Clippy){0}**：`{1}cargo clippy --all-targets -- -D warnings`".format(where, cd))
        elif stack == "go":
            lines.append("- **Go 编译与单元测试{0}**：`{1}go build ./... && go test -v ./...`".format(where, cd))
            lines.append("- **Go 静态代码检查 (Vet){0}**：`{1}go vet ./...`".format(where, cd))
        elif stack == "node":
            scripts = _package_scripts(base)
            pm = _node_package_manager(base)
            has_tsconfig = os.path.isfile(os.path.join(base, "tsconfig.json"))
            if "test" in scripts:
                # `bun test` starts Bun's built-in runner instead of scripts.test
                test_cmd = "bun run test" if pm == "bun" else pm + " test"
                typecheck = "npx tsc --noEmit && " if has_tsconfig else ""
                lines.append("- **Node/TS 类型与测试{0}**：`{1}{2}{3}`".format(where, cd, typecheck, test_cmd))
            else:
                if has_tsconfig:
                    lines.append("- **TypeScript 类型检查{0}**：`{1}npx tsc --noEmit`".format(where, cd))
                lines.append("- **Node/TS{0}**：已有 `{1}package.json`。测试命令写进 `scripts.test` 后再执行。".format(
                    where, rel + "/" if rel else ""))
            if "lint" in scripts:
                lines.append("- **Node/TS 代码风格 (Lint){0}**：`{1}{2} run lint`".format(where, cd, pm))
        else:
            pyproject = _read_text(os.path.join(base, "pyproject.toml"), errors="replace")
            tests_dir = os.path.join(base, "tests")
            test_files = [os.path.join(tests_dir, name) for name in sorted(os.listdir(tests_dir))
                          if name.startswith("test") and name.endswith(".py")] if os.path.isdir(tests_dir) else []
            # unittest discover reports "Ran 0 tests ... OK" on plain-assert pytest files
            has_pytest = (
                os.path.isfile(os.path.join(base, "pytest.ini")) or
                os.path.isfile(os.path.join(base, "conftest.py")) or
                os.path.isfile(os.path.join(tests_dir, "conftest.py")) or
                "[tool.pytest" in pyproject or
                "[tool:pytest]" in _read_text(os.path.join(base, "setup.cfg"), errors="replace") or
                "[pytest]" in _read_text(os.path.join(base, "tox.ini"), errors="replace") or
                (bool(test_files) and not any("unittest" in _read_text(path, errors="replace") for path in test_files))
            )
            has_ruff = (
                os.path.isfile(os.path.join(base, "ruff.toml")) or
                os.path.isfile(os.path.join(base, ".ruff.toml")) or
                "[tool.ruff" in pyproject
            )
            entries = [] if rel else python_entry_files(project_dir)
            if has_pytest:
                lines.append("- **Python 单元测试{0}**：`{1}pytest`".format(where, cd))
            elif test_files:
                lines.append("- **Python 单元测试{0}**：`{1}python3 -m unittest discover -s tests -v`".format(where, cd))
            else:
                lines.append("- **Python 单元测试{0}**：测试写进 `tests/` 后执行 `{1}python3 -m unittest discover -s tests -v`。".format(
                    where, cd))
            if has_ruff:
                lines.append("- **Python 代码质量{0}**：`{1}ruff check .`".format(where, cd))
            elif entries:
                lines.append("- **Python 语法检查**：`python3 -m py_compile {0}`".format(" ".join(entries)))

    if not lines:
        lines.append("- **测试验证**：`# 请在此填入该技术栈的单元测试命令（如 pytest / go test / npm test）`")
        lines.append("- **构建检查**：`# 请在此填入该技术栈的构建/语法检查命令`")

    lines.append("- **文档与代码对齐检查**：`agent-harness check`")
    requirements.append(("文档对齐检查", ["agent-harness check"]))
    return requirements, lines

def detect_test_harness(project_dir):
    """
    Detects test commands and build tools based on files in project_dir.
    Supports multi-stack monorepos (e.g. Go backend + TS frontend, or Rust core + Python bindings).
    """
    _requirements, lines = harness_plan(project_dir)
    return "\n".join(lines)

AUTO_MARK = "agent-harness:auto:{name}"

DOC_ALIGNMENT_SECTION = """### 文档与代码对齐（防下一会话漂移）
- 下一会话会把 `AGENTS.md` 与 README / `docs/` 当作事实源：改代码时同步改文档，事实源才可信。
- **必须同步文档**：对外行为、CLI/API、入口点、技术栈、测试命令、架构分层，以及逻辑与实现方法。代码里的做法变了，描述该做法的段落在同一次改动里改成现在的做法。
- 交付前运行 `agent-harness check`。检查核对技术栈、入口点和测试命令。实现文件有改动时，正文里写了这些路径的说明文档（README、`docs/`、`AGENTS.md`）也在同一次改动里被修改，检查才通过。带 `<!-- agent-harness:auto:* -->` 标记的字段可用 `agent-harness sync` 刷新。**sync 只刷新带标记的字段，第 5 节业务红线始终由开发者维护。** 要改其中某段（例如给测试命令加环境变量）时，先删掉包住这段的那对标记再改，之后 sync 跳过这一段。
- **只写正确做法**：写规则、文档、注释或会话总结时，每条约束都写成「做什么、怎么做」的肯定句，只写正确做法本身。
- **长期要求写进本文件**：开发者在对话中提出、以后所有会话都要遵守的要求，当轮用肯定句写进本文件第 5 节，并在回复中说明新增了哪一条。
- 只有测试文件改动（测试目录里的文件，以及 `*_test.go`、`*.test.ts`、`*.spec.ts`、`test_*.py` 这类测试文件）、且说明文档没有写这些测试路径时，说明文档保持原样。
"""

AUTO_VERIFY_LINE = (
    "- **自动执行**：每轮回复结束时，Cursor / Claude Code / Antigravity 的 stop hook 运行 `agent-harness verify`，"
    "在仓库根目录按顺序执行上面的命令；失败时把输出发回给智能体继续修改，最多 3 轮。上面每条命令都写成可以直接运行的完整命令。"
