CLOSED_LOOP = """**闭环铁律**：
1. 测试或编译报错时，读取具体报错栈并自行修复；全部通过后才宣告任务完成；
2. 同一个问题连续修复 3 次仍未解决（如底层依赖或设计阻塞）时，**停下来向开发者汇报具体卡点和已尝试的方案**，等待决策。
3. 改动了对外行为、入口点、技术栈、测试命令、逻辑或实现方法时，同步更新 AGENTS.md 及 README / docs 里的对应描述，并运行 `agent-harness check` 直至通过。
"""

GRAPH_RULES_SECTION = """## 4. 代码知识图谱检索纪律 (Codebase Memory)
- 探索系统架构、函数定义、依赖链路或接口路由时，**若当前会话可用 `codebase-memory-mcp` 工具，优先使用它**，先精准定位，再只读取所需的代码：
    - `get_architecture`: 快速获取系统整体拓扑、热点与分层；
    - `search_graph`: 精准查找函数、类、结构体、接口定义；
    - `trace_path`: 追踪上下游完整调用链，评估修改带来的“爆炸半径”；
    - `get_code_snippet`: 精确读取目标源码，让上下文只装必要内容。
- **若工具不可用**（未安装或未配置 MCP），直接改用常规的文件搜索与读取，照常推进任务。
"""

def format_entry_points_md(entry_points):
    if entry_points:
        return "\n".join(["- `{0}`".format(ep) for ep in entry_points])
    return "- 暂无显式 main 入口（待开发定义）"

def wrap_auto(name, inner):
    start = "<!-- " + AUTO_MARK.format(name=name) + " -->"
    end = "<!-- /" + AUTO_MARK.format(name=name) + " -->"
    return start + inner + end

def replace_auto_block(content, name, inner):
    start = "<!-- " + AUTO_MARK.format(name=name) + " -->"
    end = "<!-- /" + AUTO_MARK.format(name=name) + " -->"
    pattern = re.compile(re.escape(start) + r".*?" + re.escape(end), re.DOTALL)
    replacement = start + inner + end
    new_content, n = pattern.subn(replacement, content, count=1)
    return new_content, n > 0

def alignment_issues(target_dir):
    """Return human-readable mismatches between repo facts and AGENTS.md. Empty means aligned."""
    issues = []
    agents_path = os.path.join(target_dir, "AGENTS.md")
    if not os.path.isfile(agents_path):
        return ["缺少 AGENTS.md，请先运行 `agent-harness init`"]

    with open(agents_path, "r", encoding="utf-8", errors="ignore") as f:
        text = f.read()
    text_l = text.lower()

    languages_str, entry_points = parse_architecture(target_dir)
    skip_langs = {"自动检测 / 多语言", "自动检测", "多语言"}
    for lang in [part.strip() for part in languages_str.split(",") if part.strip()]:
        if lang in skip_langs:
            continue
        if not re.search(r"(?<![A-Za-z])" + re.escape(lang) + r"(?![A-Za-z])", text):
            issues.append("仓库含 {0} 代码，但 AGENTS.md 未记录该语言".format(lang))

    for ep in entry_points:
        if ep not in text:
            issues.append("入口点 `{0}` 存在于仓库，但 AGENTS.md 未列出".format(ep))

    requirements, _lines = harness_plan(target_dir)
    for label, commands in requirements:
        if not any(re.search(r"(?<![a-z0-9_-])" + re.escape(command.lower()), text_l) for command in commands):
            issues.append("检测到 {0}，但 AGENTS.md 未包含对应测试命令（{1}）".format(label, " / ".join(commands[:4])))

    return issues

LOGIC_EXTS = {
    ".py", ".go", ".rs", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".vue",
    ".java", ".c", ".cpp", ".h", ".rb", ".php", ".swift", ".kt",
    ".sh", ".ps1", ".cmd",
}
AUTO_BLOCK_RE = re.compile(
    r"<!-- agent-harness:auto:[^>]*-->.*?<!-- /agent-harness:auto:[^>]*-->",
    re.DOTALL,
)
TEST_DIRS = {"tests", "test", "__tests__", "spec", "testdata"}
TEST_FILE_RE = re.compile(r"^test_.*\.py$|_test\.(py|go)$|\.(test|spec)\.[a-z]+$")
URL_RE = re.compile(r"https?://\S+")
HISTORY_DOC_NAMES = {"changelog", "changes", "history"}
HISTORY_DOC_DIRS = {"adr", "adrs", "decisions"}

def list_changed_files(target_dir):
    """Changed paths under target_dir, relative to it. Inside a git commit hook (GIT_INDEX_FILE set) only staged
    changes count. None when the directory is not a git work tree."""
    probe = run_cmd(["git", "-C", target_dir, "rev-parse", "--show-prefix"])
    if probe.returncode != 0:
        return None
    prefix = probe.stdout.strip()
    res = run_cmd(["git", "-C", target_dir, "status", "--porcelain", "-z", "--untracked-files=all", "--", "."])
    if res.returncode != 0:
        return None
    staged_only = bool(os.environ.get("GIT_INDEX_FILE"))
    # -z keeps non-ASCII paths unquoted; a rename entry is followed by its source path as a separate token
    tokens = res.stdout.split("\0")
    paths = []
    i = 0
    while i < len(tokens):
        entry = tokens[i]
        i += 1
        if len(entry) < 4:
            continue
        status = entry[:2]
        names = [entry[3:]]
        if "R" in status or "C" in status:
            names.append(tokens[i] if i < len(tokens) else "")
            i += 1
        if staged_only and status[0] in " ?!":
            continue
        for name in names:
            rel = name[len(prefix):] if name.startswith(prefix) else ""
            if rel and rel not in paths:
                paths.append(rel)
    return paths

def is_logic_change(rel):
    norm = rel.replace("\\", "/")
    parts = norm.split("/")
    if TEST_DIRS.intersection(parts[:-1]) or TEST_FILE_RE.search(parts[-1]):
        return False
    ext = os.path.splitext(norm)[1].lower()
    if ext in LOGIC_EXTS:
        return True
    return norm.startswith("bin/") and ext == ""

def strip_auto_blocks(text):
    return AUTO_BLOCK_RE.sub("", text)

def path_mentioned(text, relpath):
    if not relpath:
        return False
    pattern = r"(?<![A-Za-z0-9_-])" + re.escape(relpath) + r"(?![A-Za-z0-9_/-]|\.[A-Za-z0-9_])"
    return re.search(pattern, text) is not None

def is_history_doc(rel):
    parts = rel.replace("\\", "/").lower().split("/")
    return parts[-1].split(".")[0] in HISTORY_DOC_NAMES or bool(HISTORY_DOC_DIRS.intersection(parts[:-1]))

def documentation_texts(target_dir):
    """Markdown that explains current behavior. History docs (CHANGELOG, ADR), auto blocks, and URLs are left out."""
    found = []
    for dirpath, dirs, files in os.walk(target_dir):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith(".")]
        for name in files:
            if not name.endswith(".md"):
                continue
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, target_dir).replace("\\", "/")
            if is_history_doc(rel):
                continue
            found.append((rel, URL_RE.sub("", strip_auto_blocks(_read_text(full, errors="replace")))))
    return found

def doc_drift_issues(target_dir):
    """Fail when changed logic still has a stale explanation, or no explanation was updated."""
    changed = list_changed_files(target_dir)
    if not changed:
        return []
    code_paths = [path for path in changed if is_logic_change(path)]
    if not code_paths:
        return []
    changed_docs = set(path for path in changed if path.replace("\\", "/").endswith(".md") and not is_history_doc(path))
    docs = documentation_texts(target_dir)
    issues = []
    for path in code_paths:
        norm = path.replace("\\", "/")
        cited = [rel for rel, text in docs if path_mentioned(text, norm)]
        if cited:
            stale = [rel for rel in cited if rel not in changed_docs]
            if stale:
                issues.append(
                    "代码 `{0}` 已改，这些说明仍引用它但没有一起修改：{1}。请把其中描述该行为的段落改成与代码一致。".format(
                        norm, "、".join(stale)
                    )
                )
        elif not changed_docs:
            issues.append(
                "代码 `{0}` 已改，说明文档没有写这个路径，本次也没有 Markdown 更新。请在 README、docs/ 或 AGENTS.md 写上这段行为现在的做法。".format(
                    norm
                )
            )
    return issues

def compose_supplement(existing, languages_str, entry_points_md, harness_md, karpathy_rules_md):
    """Append framework pieces a short AGENTS.md is missing. None when the file already has them."""
    chunks = []
    if "agent-harness:auto:languages" not in existing:
        chunks.append("- **主要技术栈 / 语言**：" + wrap_auto("languages", languages_str))
    if "agent-harness:auto:entries" not in existing:
        chunks.append("- **核心入口点 (Entry Points)**：\n" + wrap_auto("entries", "\n" + entry_points_md + "\n"))
    if "先想再写" not in existing:
        chunks.append(karpathy_rules_md)
    if "agent-harness:auto:harness" not in existing and "测试与校验命令" not in existing:
        chunks.append("### 本项目测试与校验命令：\n" + wrap_auto("harness", "\n" + harness_md + "\n") + "\n" + AUTO_VERIFY_LINE)
    if "文档与代码对齐" not in existing:
        chunks.append(DOC_ALIGNMENT_SECTION + "\n" + CLOSED_LOOP)
    if "search_graph" not in existing:
        chunks.append(GRAPH_RULES_SECTION)
    if not chunks:
        return None
    intro = (
        "\n\n---\n\n## agent-harness 补充\n\n"
        "上方原文继续生效。这里补上尚未写进本文件的工程围栏，已有句子保持原样。\n\n"
    )
    return existing.rstrip() + intro + "\n\n".join(chunks) + "\n"

def cmd_init(target_dir):
    target_dir = os.path.abspath(target_dir)
    if not os.path.isdir(target_dir):
        print(f"❌ Error: {target_dir} is not a valid directory.")
        sys.exit(1)

    agents_path = os.path.join(target_dir, "AGENTS.md")
    project_name = os.path.basename(target_dir)

    print(f"\n🚀 [agent-harness] Initializing project: {project_name}")
    print(f"📁 Target path: {target_dir}")

    # Step 1: Index repository
    print("⏳ Building / updating codebase knowledge graph via codebase-memory-mcp...")
    idx_res = run_cbm_cli("index_repository", {"repo_path": target_dir})
    if isinstance(idx_res, dict) and "nodes" in idx_res:
        print(f"✅ Graph indexed: {idx_res['nodes']} nodes, {idx_res.get('edges', 0)} edges.")
    elif not os.path.exists(CBM_BIN):
        print("ℹ️ Graph indexing skipped (codebase-memory-mcp not installed).")
    else:
        print("⚠️ codebase-memory-mcp gave no usable result — the engine failed to start, timed out, or changed its "
              "output format. AGENTS.md is unaffected; update agent-harness or run with DEBUG=1 for details.")

    print("🔍 Detecting languages, entry points & test commands...")
    languages_str, entry_points = parse_architecture(target_dir)
    harness_md = detect_test_harness(target_dir)
    karpathy_rules_md = load_karpathy_rules()
    entry_points_md = format_entry_points_md(entry_points)

    if os.path.exists(agents_path):
        existing = _read_text(agents_path)
        updated = compose_supplement(existing, languages_str, entry_points_md, harness_md, karpathy_rules_md)
        if updated is None:
            print(f"🛡️  AGENTS.md already has the harness sections: {agents_path}")
            print("⏭️  Leaving existing rules in place.")
            print("💡 若技术栈或测试命令已变，运行 `agent-harness sync` 刷新带标记的事实字段；交付前运行 `agent-harness check`。")
        else:
            with open(agents_path, "w", encoding="utf-8") as f:
                f.write(updated)
            print(f"✨ Kept the existing AGENTS.md and appended the missing harness sections: {agents_path}")
    else:
        print("📝 Synthesizing tailor-made AGENTS.md (Karpathy Rules + Test Harness)...")
        content = f"""# {project_name} AI 智能体开发规范与项目指令 (AGENTS.md)

欢迎来到 **{project_name}** 项目！本项目由独立全栈开发者维护。AI 智能体在进行开发与修改时，必须将本文件视为**最高工程铁律**。

> **【AI 开发纪律 · 动手前必读】**
> 在编写或修改任何代码之前，必须通读本规范。模型每次会话都从零开始，本文件是跨会话唯一可靠的记忆与代码质量围栏。**需求以开发者确认的为准；每次交付都附带实际运行通过的测试。**

---

## 1. 核心技术栈与架构基线
- **项目名称**：`{project_name}`
- **主要技术栈 / 语言**：{wrap_auto("languages", languages_str)}
- **核心入口点 (Entry Points)**：
{wrap_auto("entries", chr(10) + entry_points_md + chr(10))}

---

{karpathy_rules_md}

---

## 3. 测试框架（Test Harness）与执行闭环

> **物理围栏机制**：智能体改动代码后，必须调用终端命令自我闭环：
> `编写/修改代码` $\\to$ `运行检查命令` $\\to$ `根据报错自愈修复` $\\to$ `重新运行测试` $\\to$ `全部绿灯后交付`。

### 本项目测试与校验命令：
{wrap_auto("harness", chr(10) + harness_md + chr(10))}
{AUTO_VERIFY_LINE}

{DOC_ALIGNMENT_SECTION}
{CLOSED_LOOP}

---

{GRAPH_RULES_SECTION}

---

## 5. 业务专属红线与约束（待补充）
- *[开发者自定义区域]*：可在此处记录当前项目的特定业务逻辑、私密环境配置、核心数据模型，以及开发者在对话中提出的长期要求。
"""
        with open(agents_path, "w", encoding="utf-8") as f:
            f.write(content)
        print(f"✨ Successfully created: {agents_path}")

    # Step 3: Alias files import AGENTS.md rather than symlink it, so tools that read several rule files (e.g. Cursor) load the rules once.
    print("🔗 Ensuring cross-IDE alias files...")
    for alias in ["CLAUDE.md", "GEMINI.md"]:
        alias_path = os.path.join(target_dir, alias)
        legacy_link = os.path.islink(alias_path) and os.readlink(alias_path) == "AGENTS.md"
        if legacy_link:
            os.remove(alias_path)
        if not os.path.lexists(alias_path):
            with open(alias_path, "w", encoding="utf-8") as f:
                f.write("@AGENTS.md\n")
            print(f"  + {'Replaced symlink' if legacy_link else 'Created'}: {alias} (@AGENTS.md import)")
    cursorrules_path = os.path.join(target_dir, ".cursorrules")
    if os.path.islink(cursorrules_path) and os.readlink(cursorrules_path) == "AGENTS.md":
        os.remove(cursorrules_path)
        print("  - Removed legacy .cursorrules symlink (Cursor reads AGENTS.md natively)")

    # Step 4: Ensure gitignore safety
    git_ignore_path = os.path.join(target_dir, ".gitignore")
    if os.path.exists(git_ignore_path) and append_missing_lines(git_ignore_path, GRAPH_IGNORE_LINES):
        print("🛡️  Added .codebase-memory/ to project .gitignore")

    # Step 5: Stop hooks run the AGENTS.md commands at the end of each agent turn
    print("🔁 Ensuring stop hooks (agent-harness verify)...")
    install_stop_hooks(target_dir)

    print(f"\n🎉 [agent-harness] Ready! You can now start chatting with AI in any tool (TRAE, Cursor, Claude Code, Antigravity).\n")

def cmd_check(target_dir):
    target_dir = os.path.abspath(target_dir)
    if not os.path.isdir(target_dir):
        print(f"❌ Error: {target_dir} is not a valid directory.")
        sys.exit(1)

    issues = alignment_issues(target_dir)
    issues.extend(doc_drift_issues(target_dir))
    if issues:
        print("❌ AGENTS.md 与仓库事实不对齐，或说明文档没有跟上代码改动：\n")
        for item in issues:
            print("  - {0}".format(item))
        print("\n修复：更新 AGENTS.md 的技术栈、入口点和测试命令；实现有改动时，同步改写引用这些路径的说明段落。标记字段可运行 `agent-harness sync`。")
        sys.exit(1)

    print("✅ 技术栈、入口点、测试命令与说明文档检查通过。")

def cmd_sync(target_dir):
    target_dir = os.path.abspath(target_dir)
    if not os.path.isdir(target_dir):
        print(f"❌ Error: {target_dir} is not a valid directory.")
        sys.exit(1)

    agents_path = os.path.join(target_dir, "AGENTS.md")
    if not os.path.isfile(agents_path):
        print("❌ 缺少 AGENTS.md，请先运行 `agent-harness init`。")
        sys.exit(1)

    languages_str, entry_points = parse_architecture(target_dir)
    harness_md = detect_test_harness(target_dir)
    entry_points_md = format_entry_points_md(entry_points)

    with open(agents_path, "r", encoding="utf-8") as f:
        content = f.read()
    original = content

    updates = []
    skipped = []
    content, ok = replace_auto_block(content, "languages", languages_str)
    (updates if ok else skipped).append("languages")
    content, ok = replace_auto_block(content, "entries", "\n" + entry_points_md + "\n")
    (updates if ok else skipped).append("entries")
    content, ok = replace_auto_block(content, "harness", "\n" + harness_md + "\n")
    (updates if ok else skipped).append("harness")

    if not updates:
        print("❌ AGENTS.md 中没有 `agent-harness:auto:*` 标记，拒绝改写手写文档。")
        print("   新项目请用当前版本 `agent-harness init`；已有文档可把要托管的段落包进标记后再 sync。")
        sys.exit(1)

    if content != original:
        with open(agents_path, "w", encoding="utf-8") as f:
            f.write(content)
        print("✨ 已刷新 AGENTS.md 自动托管字段：{0}。第 5 节业务红线未改。".format(", ".join(updates)))
    else:
        print("✅ 自动托管字段已是最新：{0}。".format(", ".join(updates)))

    if skipped:
        print("⏭️  无标记字段已跳过（手写保护）：{0}".format(", ".join(skipped)))

    issues = alignment_issues(target_dir)
    if issues:
        print("⚠️  刷新后仍有缺口，请手工补全：")
        for item in issues:
            print("  - {0}".format(item))
        sys.exit(1)

def load_json_config(path):
    """JSON object stored at path; {} when missing, empty, or not an object. Unparseable files are copied to .bak first."""
    data = {}
    if os.path.exists(path) and os.path.getsize(path) > 0:
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception as e:
            bak_path = path + ".bak"
            print(f"  ⚠️ Warning: Failed to parse existing JSON at {path} ({e})")
            print(f"     Creating backup at {bak_path} before updating.")
            try:
                shutil.copyfile(path, bak_path)
            except Exception:
                pass
            data = {}
    return data if isinstance(data, dict) else {}

def write_json_config(path, data):
    """Write a temp file next to path, then swap it in, so an interrupted write leaves the old file whole."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp_path = path + ".agent-harness.tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        if os.path.exists(path):
            shutil.copymode(path, tmp_path)
        os.replace(tmp_path, path)
    finally:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)

def safe_inject_mcp(target_path, ide_name):
    """Safely injects codebase-memory-mcp into an IDE's JSON configuration with corruption backup."""
    data = load_json_config(target_path)
    data.setdefault("mcpServers", {})["codebase-memory-mcp"] = {
        "command": CBM_BIN,
        "args": []
    }
    write_json_config(target_path, data)
    print(f"  ✅ Configured {ide_name} MCP: {target_path}")

HOOK_COMMAND = "agent-harness verify --hook"
HOOK_TIMEOUT = 300
# Leaves time to report a timeout before the IDE kills the hook at HOOK_TIMEOUT
VERIFY_BUDGET = HOOK_TIMEOUT - 30
MAX_VERIFY_ROUNDS = 3
# (config file, top-level defaults, keys down to the stop-hook list, entry appended to that list)
STOP_HOOK_TARGETS = [
    (".cursor/hooks.json", {"version": 1}, ["hooks", "stop"],
     {"command": HOOK_COMMAND, "timeout": HOOK_TIMEOUT, "loop_limit": MAX_VERIFY_ROUNDS}),
    (".claude/settings.json", {}, ["hooks", "Stop"],
     {"hooks": [{"type": "command", "command": HOOK_COMMAND, "timeout": HOOK_TIMEOUT}]}),
    (".agents/hooks.json", {}, ["agent-harness-verify", "Stop"],
     {"type": "command", "command": HOOK_COMMAND, "timeout": HOOK_TIMEOUT}),
]
VERIFY_STATE_FILE = os.path.join(tempfile.gettempdir(), "agent-harness-verify.json")
COMMAND_LINE_RE = re.compile(r"^\s*[-*]\s+\*\*[^*]+\*\*\s*[：:]\s*`([^`]+)`\s*$")

def install_stop_hooks(target_dir):
    """Add the verify stop hook to each IDE's project config, keeping every existing entry."""
    for rel, defaults, keys, entry in STOP_HOOK_TARGETS:
        path = os.path.join(target_dir, *rel.split("/"))
        data = load_json_config(path)
        for key, value in defaults.items():
            data.setdefault(key, value)
        node = data
        for key in keys[:-1]:
            node = node.setdefault(key, {}) if isinstance(node, dict) else None
        entries = node.setdefault(keys[-1], []) if isinstance(node, dict) else None
        if not isinstance(entries, list):
            print("  ⚠️ {0} has an unexpected layout; add `{1}` as a stop hook by hand.".format(rel, HOOK_COMMAND))
            continue
        if HOOK_COMMAND in json.dumps(entries):
            continue
        entries.append(entry)
        write_json_config(path, data)
        print("  + Stop hook: {0}".format(rel))

def find_project_root(start):
    """Nearest directory at or above start that holds AGENTS.md; None when there is none."""
    path = os.path.abspath(start)
    while not os.path.isfile(os.path.join(path, "AGENTS.md")):
        parent = os.path.dirname(path)
        if parent == path:
            return None
        path = parent
    return path

def harness_commands(agents_text):
    """Commands written as "- **名称**：`命令`" under the 测试与校验命令 heading. Placeholders start with #."""
    commands = []
    in_section = False
    for line in agents_text.splitlines():
        if line.startswith("#"):
            in_section = "测试与校验命令" in line
            continue
        match = COMMAND_LINE_RE.match(line) if in_section else None
        if match and not match.group(1).strip().startswith("#"):
            commands.append(match.group(1).strip())
    return commands

def run_shell(command, cwd, env, timeout=None):
    """(exit code, output) of a shell command. Exit code None: it ran past timeout and was stopped with its children."""
    # A file, unlike a pipe, lets wait() return while an orphaned child still holds the output open
    with tempfile.TemporaryFile() as out:
        proc = subprocess.Popen(command, shell=True, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        try:
            code = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            code = None
            if sys.platform == "win32":
                subprocess.run(["taskkill", "/F", "/T", "/PID", str(proc.pid)], capture_output=True)
            else:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass
            proc.wait()
        out.seek(0)
        return code, out.read().decode("utf-8", "replace").replace("\r\n", "\n")

def run_harness_commands(root, echo=False, budget=None):
    """Run the AGENTS.md commands from root in order. (command, output tail) for the first failure, else None.
    With a budget in seconds, the command still running when it runs out is stopped and reported as the failure."""
    commands = harness_commands(_read_text(os.path.join(root, "AGENTS.md"), errors="replace"))
    deadline = time.monotonic() + budget if budget else None
    env = dict(os.environ)
    env.setdefault("PYTHONIOENCODING", "utf-8")
    with tempfile.TemporaryDirectory() as shim_dir:
        if sys.platform == "win32":
            # python.org installs on Windows ship python.exe only; AGENTS.md commands call python3
            with open(os.path.join(shim_dir, "python3.cmd"), "w") as f:
                f.write('@"{0}" %*\n'.format(sys.executable))
            env["PATH"] = shim_dir + os.pathsep + env.get("PATH", "")
        for command in commands:
            if echo:
                print("▶ {0}".format(command), flush=True)
            code, output = run_shell(command, root, env, max(deadline - time.monotonic(), 1) if deadline else None)
            if echo:
                print(output, end="", flush=True)
            tail = "\n".join(output.splitlines()[-60:])
            if code is None:
                return command, tail + (
                    "\n\n（校验限时 {0} 秒，这条命令到时仍未结束，已被停止。请让它能自己结束：关闭 watch 模式、"
                    "去掉等待输入的步骤；只是首次编译慢的话，先在终端完整运行一次，之后会快很多。）".format(budget))
            if code != 0:
                return command, tail
    return None

def tree_fingerprint(root):
    """(dirty, digest) of HEAD, git status, and the size and mtime of each changed file; None outside a git repo."""
    status = run_cmd(["git", "-C", root, "status", "--porcelain", "-z", "--untracked-files=all"])
    if status.returncode != 0:
        return None
    top, _, head = run_cmd(["git", "-C", root, "rev-parse", "--show-toplevel", "HEAD"]).stdout.partition("\n")
    digest = hashlib.sha1((head + status.stdout).encode("utf-8"))
    for entry in filter(None, status.stdout.split("\0")):
        try:
            info = os.stat(os.path.join(top.strip(), entry[3:]))
        except OSError:
            continue
        digest.update("{0}\0{1}\0{2}\0".format(entry, info.st_size, info.st_mtime_ns).encode("utf-8"))
    return bool(status.stdout), digest.hexdigest()

def _load_verify_state():
    """{"trees": {root: fingerprint seen last}, "rounds": {root|conversation: failing rounds in a row}}"""
    try:
        with open(VERIFY_STATE_FILE, "r", encoding="utf-8") as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    state = state if isinstance(state, dict) else {}
    for key in ("trees", "rounds"):
        if not isinstance(state.get(key), dict):
            state[key] = {}
    return state

def verify_hook_response(root, event):
    """Stop-hook reply in the calling IDE's format: ask the agent to keep fixing while an AGENTS.md command fails.
    The commands run only when files changed since the hook last looked, so question-only turns end at once."""
    reason = str(event.get("terminationReason", "")).lower()
    if event.get("status") in ("aborted", "error") or event.get("error") or any(
            word in reason for word in ("error", "cancel", "abort", "max_steps")):
        return {}
    tree = tree_fingerprint(root) if root else None
    if tree is None:
        return {}
    dirty, digest = tree
    state = _load_verify_state()
    last = state["trees"].get(root)
    failure = None
    if digest != last and (dirty or last is not None):
        failure = run_harness_commands(root, budget=VERIFY_BUDGET)
        # The commands may leave files of their own; the next turn compares against the tree they left
        digest = (tree_fingerprint(root) or tree)[1]
    state["trees"][root] = digest
    antigravity = "terminationReason" in event
    claude = "stop_hook_active" in event
    rounds = 0
    # Cursor caps the rounds itself through loop_limit
    if antigravity or claude:
        key = "{0}|{1}".format(root, event.get("conversationId") or event.get("session_id") or "")
        rounds = state["rounds"].get(key, 0) + 1 if failure else 0
        if 0 < rounds <= MAX_VERIFY_ROUNDS:
            state["rounds"][key] = rounds
        else:
            state["rounds"].pop(key, None)
    try:
        with open(VERIFY_STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(state, f)
    except OSError:
        pass
    if failure is None or rounds > MAX_VERIFY_ROUNDS:
        return {}
    message = "自动校验未通过：`{0}`。请根据下面的输出修复，修好后简要说明改了什么。\n\n{1}".format(*failure)
    if antigravity:
        return {"decision": "continue", "reason": message}
    if claude:
        return {"decision": "block", "reason": message}
    return {"followup_message": message}

def cmd_verify(args):
    hook = "--hook" in args
    paths = [arg for arg in args if arg != "--hook"]
    root = find_project_root(paths[0] if paths else os.getcwd())
    if hook:
        try:
            event = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            event = {}
        print(json.dumps(verify_hook_response(root, event if isinstance(event, dict) else {}), ensure_ascii=False))
        return
    if root is None:
        print("❌ 没有找到 AGENTS.md，请先运行 `agent-harness init`。")
        sys.exit(1)
    failure = run_harness_commands(root, echo=True)
    if failure:
        print("\n❌ 校验未通过：`{0}`".format(failure[0]))
        sys.exit(1)
    print("\n✅ AGENTS.md 里的测试与校验命令全部通过。")

def append_missing_lines(path, lines):
    existing = _read_text(path)
    missing = [line for line in lines if line not in existing]
    if not missing:
        return False
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    block = ""
    if existing and not existing.endswith("\n"):
        block += "\n"
    if "# codebase-memory-mcp" not in existing:
        block += "# codebase-memory-mcp\n"
    block += "\n".join(missing) + "\n"
    with open(path, "a", encoding="utf-8") as f:
        f.write(block)
    return True

def configure_global_git_excludes():
    """Append graph ignore rules to the excludes file git already uses. Set core.excludesfile only when unset."""
    probe = run_cmd(["git", "config", "--global", "--get", "core.excludesfile"])
    configured = probe.returncode == 0 and bool((probe.stdout or "").strip())
    if configured:
        path = os.path.expanduser(probe.stdout.strip())
        if not os.path.isabs(path):
            path = os.path.join(os.path.expanduser("~"), path)
    else:
        path = os.path.expanduser("~/.gitignore_global")
    added = append_missing_lines(path, GRAPH_IGNORE_LINES)
    if not configured:
        run_cmd(["git", "config", "--global", "core.excludesfile", path])
        print("  🛡️  Set core.excludesfile to {0}".format(path))
    elif added:
        print("  🛡️  Appended graph ignore rules to existing excludes file: {0}".format(path))
    else:
        print("  🛡️  Graph ignore rules already in {0}".format(path))

def cmd_setup():
    print(BANNER)
    print("🔧 [agent-harness] Writing MCP config for TRAE, Cursor, Claude Code, Antigravity, and Windsurf...\n")
    
    # 1. TRAE
    appdata = os.environ.get("APPDATA", "")
    trae_paths = [os.path.expanduser("~/.trae/mcp.json")]
    if sys.platform == "darwin":
        trae_paths.append(os.path.expanduser("~/Library/Application Support/TRAE SOLO CN/User/mcp.json"))
        trae_paths.append(os.path.expanduser("~/Library/Application Support/Trae/User/mcp.json"))
    elif sys.platform == "win32" and appdata:
        trae_paths.append(os.path.join(appdata, "Trae", "User", "mcp.json"))
        trae_paths.append(os.path.join(appdata, "TRAE SOLO CN", "User", "mcp.json"))
        
    for tp in trae_paths:
        safe_inject_mcp(tp, "TRAE")

    # 2. Cursor
    cursor_mcp = os.path.expanduser("~/.cursor/mcp.json")
    safe_inject_mcp(cursor_mcp, "Cursor")

    # 3. Claude Code
    claude_json = os.path.expanduser("~/.claude.json")
    safe_inject_mcp(claude_json, "Claude Code")

    # 4. Antigravity / Gemini CLI
    gemini_mcp = os.path.expanduser("~/.gemini/config/mcp_config.json")
    safe_inject_mcp(gemini_mcp, "Antigravity")

    # 5. Windsurf
    windsurf_paths = [os.path.expanduser("~/.codeium/windsurf/mcp_config.json")]
    if sys.platform == "win32" and appdata:
        userprofile = os.environ.get("USERPROFILE", "")
        if userprofile:
            windsurf_paths.append(os.path.join(userprofile, ".codeium", "windsurf", "mcp_config.json"))
    for wp in windsurf_paths:
        safe_inject_mcp(wp, "Windsurf")

    # Zed and VS Code read AGENTS.md from the repo; setup does not write an MCP file for them.
    configure_global_git_excludes()

    print("\n✨ All supported AI development tools are configured and ready!\n")

def cmd_status():
    print(BANNER)
    print("📊 [agent-harness] Checking daemon & knowledge graph status...\n")
    if not os.path.exists(CBM_BIN):
        print(f"❌ Error: {CBM_BIN} not found. Please install codebase-memory-mcp first.")
        return

    # Check daemon via run_cbm_cli
    data = run_cbm_cli("list_projects", {"format": "json"})
    if isinstance(data, dict) and isinstance(data.get("projects"), list):
        projects = data["projects"]
        print("🟢 Knowledge Graph Engine: Running")
        print(f"📁 Indexed Projects: {len(projects)}")
        for p in projects:
            name = p.get("name", "")
            root = p.get("root_path", "")
            print(f"   • {name} -> {root}")
        if ui_listening():
            print("\n🌐 3D 图谱界面：http://localhost:{0}\n".format(UI_PORT))
        else:
            print("\n⚪ 3D 图谱界面没有运行，`agent-harness ui` 会说明怎么打开。\n")
        return
    print("⚠️ Could not fetch projects list from daemon.")

def ui_listening():
    """True when something accepts connections on the visualizer port."""
    try:
        socket.create_connection(("127.0.0.1", UI_PORT), timeout=1).close()
    except OSError:
        return False
    return True

def cmd_ui():
    url = "http://localhost:{0}".format(UI_PORT)
    if not ui_listening():
        print("⚠️ 3D 图谱界面 {0} 没有运行。它跟着 codebase-memory-mcp 引擎启动：".format(url))
        print("   1. 打开 Cursor 等已配置该引擎的 AI 工具，再运行一次 `agent-harness ui`；")
        print("   2. 仍打不开时运行 `codebase-memory-mcp config set ui_enabled true` 打开界面开关，然后重启 AI 工具。")
        sys.exit(1)
    print(f"🌐 Opening {url} in your default browser...")
    webbrowser.open(url)

def main():
    # Windows pipes default to the ANSI code page, which cannot encode the emoji and Chinese text printed here
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8", errors="replace")
    args = sys.argv[1:]
    if os.path.splitext(os.path.basename(sys.argv[0]))[0] == "cbm-init":
        args = ["init"] + args
    if not args or args[0] in ["-h", "--help", "help"]:
        print_help()
        sys.exit(0)

    subcmd = args[0].lower()
    target = args[1] if len(args) > 1 else "."

    if subcmd == "init":
        cmd_init(target)
    elif subcmd == "check":
        cmd_check(target)
    elif subcmd == "sync":
        cmd_sync(target)
    elif subcmd == "verify":
        cmd_verify(args[1:])
    elif subcmd == "setup":
        cmd_setup()
    elif subcmd == "status":
        cmd_status()
    elif subcmd == "ui":
        cmd_ui()
    elif subcmd in ["-v", "--version", "version"]:
        print(f"agent-harness version {VERSION}")
    else:
        print(f"Unknown command: {subcmd}")
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
