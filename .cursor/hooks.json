{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "python3 bin/agent-harness verify --hook",
        "timeout": 300,
        "loop_limit": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 bin/agent-harness guard",
        "matcher": "git"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 bin/agent-harness guard",
        "matcher": "index_repository"
      }
    ]
  }
}
